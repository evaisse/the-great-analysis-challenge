# Piece-square tables from AI_ALGORITHM_SPEC.md (generated by
# tools/gen_pst.py), White's view, indexed by square (a1 = 0). Each table
# packs four entries per U32 word as bytes holding value + 50; a lookup
# walks the word index bit by bit.
import Base
import ./board.bend as B

def pst.pawn(+i: U32) -> U32:
  +w = U32.shrn(i, 2n)
  +word = B.sel(B.bit(w, 8), B.sel(B.bit(w, 4), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 842150450, 842150450), B.sel(B.bit(w, 1), 1684300900, 1684300900)), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 1010583120, 1346780220), B.sel(B.bit(w, 1), 926366795, 1262237495))), B.sel(B.bit(w, 4), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 842150470, 1177694770), B.sel(B.bit(w, 1), 925706290, 841493815)), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 926694430, 507264055), B.sel(B.bit(w, 1), 842150450, 842150450))))
  U32.sub(U32.and(U32.shrn(word, U32.to_nat(U32.shln(U32.and(i, 3), 3n))), 255), 50)

def pst.knight(+i: U32) -> U32:
  +w = U32.shrn(i, 2n)
  +word = B.sel(B.bit(w, 8), B.sel(B.bit(w, 4), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 660500, 336857600), B.sel(B.bit(w, 1), 169751090, 842145290)), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 338836545, 1094464020), B.sel(B.bit(w, 1), 339165510, 1178679060))), B.sel(B.bit(w, 4), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 338837830, 1178677780), B.sel(B.bit(w, 1), 339164225, 1094465300)), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 169751095, 926031370), B.sel(B.bit(w, 1), 660500, 336857600))))
  U32.sub(U32.and(U32.shrn(word, U32.to_nat(U32.shln(U32.and(i, 3), 3n))), 255), 50)

def pst.bishop(+i: U32) -> U32:
  +w = U32.shrn(i, 2n)
  +word = B.sel(B.bit(w, 8), B.sel(B.bit(w, 4), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 505948200, 673720350), B.sel(B.bit(w, 1), 674378290, 842150440)), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 674379580, 1010250280), B.sel(B.bit(w, 1), 674707260, 1010251560))), B.sel(B.bit(w, 4), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 674380860, 1010577960), B.sel(B.bit(w, 1), 675036220, 1010580520)), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 674705970, 842151720), B.sel(B.bit(w, 1), 505948200, 673720350))))
  U32.sub(U32.and(U32.shrn(word, U32.to_nat(U32.shln(U32.and(i, 3), 3n))), 255), 50)

def pst.rook(+i: U32) -> U32:
  +w = U32.shrn(i, 2n)
  +word = B.sel(B.bit(w, 8), B.sel(B.bit(w, 4), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 842150450, 842150450), B.sel(B.bit(w, 1), 926694460, 1010580535)), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 758264370, 842150445), B.sel(B.bit(w, 1), 758264370, 842150445))), B.sel(B.bit(w, 4), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 758264370, 842150445), B.sel(B.bit(w, 1), 758264370, 842150445)), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 758264370, 842150445), B.sel(B.bit(w, 1), 842150455, 926036530))))
  U32.sub(U32.and(U32.shrn(word, U32.to_nat(U32.shln(U32.and(i, 3), 3n))), 255), 50)

def pst.queen(+i: U32) -> U32:
  +w = U32.shrn(i, 2n)
  +word = B.sel(B.bit(w, 8), B.sel(B.bit(w, 4), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 505948205, 757606430), B.sel(B.bit(w, 1), 674378290, 842150440)), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 674379575, 926364200), B.sel(B.bit(w, 1), 758265655, 926364205))), B.sel(B.bit(w, 4), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 758265655, 926364210), B.sel(B.bit(w, 1), 674379575, 926365480)), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 674378290, 842478120), B.sel(B.bit(w, 1), 505948205, 757606430))))
  U32.sub(U32.and(U32.shrn(word, U32.to_nat(U32.shln(U32.and(i, 3), 3n))), 255), 50)

def pst.king(+i: U32) -> U32:
  +w = U32.shrn(i, 2n)
  +word = B.sel(B.bit(w, 8), B.sel(B.bit(w, 4), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 336202240, 657940), B.sel(B.bit(w, 1), 336202240, 657940)), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 336202240, 657940), B.sel(B.bit(w, 1), 336202240, 657940))), B.sel(B.bit(w, 4), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 504632330, 169088030), B.sel(B.bit(w, 1), 673062430, 505290280)), B.sel(B.bit(w, 2), B.sel(B.bit(w, 1), 1179005490, 842155590), B.sel(B.bit(w, 1), 1179663410, 842813510))))
  U32.sub(U32.and(U32.shrn(word, U32.to_nat(U32.shln(U32.and(i, 3), 3n))), 255), 50)

# the bonus of piece type t (1..6) at index i
def pst(+t: U32, +i: U32) -> U32:
  B.sel(B.eq(t, 1), pst.pawn(i), B.sel(B.eq(t, 2), pst.knight(i), B.sel(B.eq(t, 3), pst.bishop(i),
    B.sel(B.eq(t, 4), pst.rook(i), B.sel(B.eq(t, 5), pst.queen(i), pst.king(i))))))
